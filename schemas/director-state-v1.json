{
  "$defs": {
    "Arc": {
      "additionalProperties": false,
      "properties": {
        "source_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 1000,
          "title": "Source Ids",
          "type": "array"
        },
        "source_hashes": {
          "additionalProperties": {
            "type": "string"
          },
          "maxProperties": 1000,
          "propertyNames": {
            "format": "uuid"
          },
          "title": "Source Hashes",
          "type": "object"
        },
        "source_fact_versions": {
          "additionalProperties": {
            "type": "integer"
          },
          "maxProperties": 1000,
          "propertyNames": {
            "format": "uuid"
          },
          "title": "Source Fact Versions",
          "type": "object"
        },
        "source_card_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Card Sha256"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "description": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "resolution": {
          "anyOf": [
            {
              "maxLength": 4000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolution"
        },
        "status": {
          "enum": [
            "open",
            "resolved"
          ],
          "title": "Status",
          "type": "string"
        },
        "knower_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Knower Ids",
          "type": "array"
        },
        "proposal_id": {
          "format": "uuid",
          "title": "Proposal Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "description",
        "status",
        "knower_ids",
        "proposal_id"
      ],
      "title": "Arc",
      "type": "object"
    },
    "DirectorPolicy": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "before_reply": {
          "default": true,
          "title": "Before Reply",
          "type": "boolean"
        },
        "after_every_messages": {
          "default": 4,
          "maximum": 100,
          "minimum": 1,
          "title": "After Every Messages",
          "type": "integer"
        },
        "pre_timeout_seconds": {
          "default": 15,
          "maximum": 60,
          "minimum": 1,
          "title": "Pre Timeout Seconds",
          "type": "number"
        },
        "max_actions": {
          "default": 8,
          "maximum": 16,
          "minimum": 1,
          "title": "Max Actions",
          "type": "integer"
        },
        "max_output_tokens": {
          "default": 768,
          "maximum": 2048,
          "minimum": 128,
          "title": "Max Output Tokens",
          "type": "integer"
        },
        "model_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Id"
        },
        "profile_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Profile Id"
        },
        "auto_apply": {
          "default": false,
          "title": "Auto Apply",
          "type": "boolean"
        },
        "auto_initiative": {
          "default": false,
          "title": "Auto Initiative",
          "type": "boolean"
        },
        "offscene": {
          "default": true,
          "title": "Offscene",
          "type": "boolean"
        },
        "actor_entities": {
          "additionalProperties": {
            "format": "uuid",
            "type": "string"
          },
          "maxProperties": 100,
          "propertyNames": {
            "format": "uuid"
          },
          "title": "Actor Entities",
          "type": "object"
        },
        "actor_attribute_keys": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "maxProperties": 100,
          "propertyNames": {
            "format": "uuid"
          },
          "title": "Actor Attribute Keys",
          "type": "object"
        }
      },
      "title": "DirectorPolicy",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": 1,
      "default": 1,
      "title": "Format",
      "type": "integer"
    },
    "policy": {
      "$ref": "#/$defs/DirectorPolicy"
    },
    "arcs": {
      "additionalProperties": {
        "$ref": "#/$defs/Arc"
      },
      "propertyNames": {
        "format": "uuid"
      },
      "title": "Arcs",
      "type": "object"
    },
    "audit": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Audit",
      "type": "array"
    }
  },
  "title": "DirectorState",
  "type": "object"
}
