{
  "type": "object",
  "required": [
    "request_sha256",
    "request_hash_fields",
    "full_context_saved",
    "profile_chain"
  ],
  "properties": {
    "request_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "request_hash_fields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "full_context_saved": {
      "type": "boolean"
    },
    "profile_chain": {
      "type": "array"
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "properties": {
          "role": {
            "enum": [
              "system",
              "user",
              "assistant"
            ]
          },
          "content": {
            "type": "string"
          }
        }
      }
    }
  },
  "if": {
    "properties": {
      "full_context_saved": {
        "const": true
      }
    }
  },
  "then": {
    "required": [
      "messages"
    ]
  }
}
