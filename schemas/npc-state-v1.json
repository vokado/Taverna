{
  "$defs": {
    "Emotion": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "default": "спокойствие",
          "enum": [
            "спокойствие",
            "радость",
            "печаль",
            "страх",
            "гнев",
            "интерес",
            "удивление",
            "отвращение",
            "смущение",
            "надежда"
          ],
          "title": "Label",
          "type": "string"
        },
        "intensity": {
          "default": 0.2,
          "maximum": 1,
          "minimum": 0,
          "title": "Intensity",
          "type": "number"
        },
        "valence": {
          "default": 0,
          "maximum": 1,
          "minimum": -1,
          "title": "Valence",
          "type": "number"
        },
        "arousal": {
          "default": 0.2,
          "maximum": 1,
          "minimum": 0,
          "title": "Arousal",
          "type": "number"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        }
      },
      "title": "Emotion",
      "type": "object"
    },
    "Intention": {
      "additionalProperties": false,
      "properties": {
        "source_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 1000,
          "title": "Source Ids",
          "type": "array"
        },
        "source_hashes": {
          "additionalProperties": {
            "type": "string"
          },
          "maxProperties": 1000,
          "propertyNames": {
            "format": "uuid"
          },
          "title": "Source Hashes",
          "type": "object"
        },
        "source_fact_versions": {
          "additionalProperties": {
            "type": "integer"
          },
          "maxProperties": 1000,
          "propertyNames": {
            "format": "uuid"
          },
          "title": "Source Fact Versions",
          "type": "object"
        },
        "source_card_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Card Sha256"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "text": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "proposal_id": {
          "format": "uuid",
          "title": "Proposal Id",
          "type": "string"
        },
        "scene_id": {
          "format": "uuid",
          "title": "Scene Id",
          "type": "string"
        },
        "status": {
          "default": "proposed_action",
          "enum": [
            "proposed_action",
            "turn_generated",
            "dismissed"
          ],
          "title": "Status",
          "type": "string"
        },
        "result_message_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Result Message Id"
        }
      },
      "required": [
        "id",
        "text",
        "proposal_id",
        "scene_id"
      ],
      "title": "Intention",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": 1,
      "default": 1,
      "title": "Format",
      "type": "integer"
    },
    "mode": {
      "default": "fixed",
      "enum": [
        "fixed",
        "flexible",
        "developing"
      ],
      "title": "Mode",
      "type": "string"
    },
    "emotions_enabled": {
      "default": true,
      "title": "Emotions Enabled",
      "type": "boolean"
    },
    "relationships_enabled": {
      "default": true,
      "title": "Relationships Enabled",
      "type": "boolean"
    },
    "emotion": {
      "$ref": "#/$defs/Emotion"
    },
    "traits": {
      "additionalProperties": {
        "type": "number"
      },
      "maxProperties": 8,
      "propertyNames": {
        "enum": [
          "trustfulness",
          "courage",
          "patience",
          "assertiveness",
          "curiosity",
          "empathy",
          "optimism",
          "discipline"
        ]
      },
      "title": "Traits",
      "type": "object"
    },
    "adaptations": {
      "additionalProperties": {
        "type": "number"
      },
      "maxProperties": 8,
      "propertyNames": {
        "enum": [
          "trustfulness",
          "courage",
          "patience",
          "assertiveness",
          "curiosity",
          "empathy",
          "optimism",
          "discipline"
        ]
      },
      "title": "Adaptations",
      "type": "object"
    },
    "adaptation_scene_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Adaptation Scene Id"
    },
    "intentions": {
      "items": {
        "$ref": "#/$defs/Intention"
      },
      "maxItems": 100,
      "title": "Intentions",
      "type": "array"
    },
    "history": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "History",
      "type": "array"
    },
    "extras": {
      "additionalProperties": true,
      "title": "Extras",
      "type": "object"
    }
  },
  "title": "NPCState",
  "type": "object"
}
