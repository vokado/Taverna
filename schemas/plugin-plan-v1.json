      "required": [
        "expected_revision",
        "type",
        "target",
        "result_id"
      ],
      "title": "TemplateRun",
      "type": "object"
    },
    "ToolEntry": {
      "additionalProperties": false,
      "properties": {
        "format": {
          "const": 1,
          "default": 1,
          "title": "Format",
          "type": "integer"
        },
        "kind": {
          "enum": [
            "note",
            "bookmark",
            "dictionary",
            "name_generator",
            "template"
          ],
          "title": "Kind",
          "type": "string"
        },
        "title": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "text": {
          "default": "",
          "maxLength": 262144,
          "title": "Text",
          "type": "string"
        },
        "references": {
          "items": {
            "$ref": "#/$defs/OwnerReference"
          },
          "maxItems": 100,
          "title": "References",
          "type": "array"
        },
        "links": {
          "items": {
            "$ref": "#/$defs/BookLink"
          },
          "maxItems": 100,
          "title": "Links",
          "type": "array"
        },
        "archived": {
          "default": false,
          "title": "Archived",
          "type": "boolean"
        },
        "generator": {
          "anyOf": [
            {
              "$ref": "#/$defs/NameGenerator"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "template": {
          "anyOf": [
            {
              "$ref": "#/$defs/ToolTemplate"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "kind",
        "title"
      ],
      "title": "ToolEntry",
      "type": "object"
    },
    "ToolTemplate": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "default": "note",
          "enum": [
            "note",
            "chapter"
          ],
          "title": "Action",
          "type": "string"
        },
        "text": {
          "default": "",
          "maxLength": 64000,
          "title": "Text",
          "type": "string"
        },
        "variables": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Variables",
          "type": "array"
        },
        "grants": {
          "items": {
            "enum": [
              "notes.write",
              "manuscripts.write"
            ],
            "type": "string"
          },
          "maxItems": 2,
          "title": "Grants",
          "type": "array"
        }
      },
      "title": "ToolTemplate",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": 1,
      "default": 1,
      "title": "Format",
      "type": "integer"
    },
    "actions": {
      "items": {
        "discriminator": {
          "mapping": {
            "book.save": "#/$defs/BookSave",
            "note.save": "#/$defs/NoteSave",
            "own.delete": "#/$defs/OwnDelete",
            "own.set": "#/$defs/OwnSet",
            "tool.template": "#/$defs/TemplateRun"
          },
          "propertyName": "type"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/OwnSet"
          },
          {
            "$ref": "#/$defs/OwnDelete"
          },
          {
            "$ref": "#/$defs/NoteSave"
          },
          {
            "$ref": "#/$defs/BookSave"
          },
          {
            "$ref": "#/$defs/TemplateRun"
          }
        ]
      },
      "maxItems": 32,
      "title": "Actions",
      "type": "array"
    },
    "message": {
      "default": "",
      "maxLength": 8000,
      "title": "Message",
      "type": "string"
    }
  },
  "title": "PluginPlan",
  "type": "object"
}
