{
  "$defs": {
    "BookLink": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "target": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "label",
        "target"
      ],
      "title": "BookLink",
      "type": "object"
    },
    "BookMedia": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "format": "uuid",
          "title": "Asset Id",
          "type": "string"
        },
        "caption": {
          "default": "",
          "maxLength": 2000,
          "title": "Caption",
          "type": "string"
        }
      },
      "required": [
        "asset_id"
      ],
      "title": "BookMedia",
      "type": "object"
    },
    "BookSave": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "book.save",
          "title": "Type",
          "type": "string"
        },
        "target": {
          "format": "uuid",
          "title": "Target",
          "type": "string"
        },
        "expected_revision": {
          "minimum": 0,
          "title": "Expected Revision",
          "type": "integer"
        },
        "payload": {
          "$ref": "#/$defs/Manuscript"
        }
      },
      "required": [
        "type",
        "target",
        "expected_revision",
        "payload"
      ],
      "title": "BookSave",
      "type": "object"
    },
    "Chapter": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "text": {
          "default": "",
          "maxLength": 1048576,
          "title": "Text",
          "type": "string"
        },
        "links": {
          "items": {
            "$ref": "#/$defs/BookLink"
          },
          "maxItems": 100,
          "title": "Links",
          "type": "array"
        },
        "media": {
          "items": {
            "$ref": "#/$defs/BookMedia"
          },
          "maxItems": 100,
          "title": "Media",
          "type": "array"
        }
      },
      "required": [
        "title"
      ],
      "title": "Chapter",
      "type": "object"
    },
    "JsonValue": {},
    "Manuscript": {
      "additionalProperties": false,
      "properties": {
        "format": {
          "const": 1,
          "default": 1,
          "title": "Format",
          "type": "integer"
        },
        "title": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "author": {
          "default": "",
          "maxLength": 300,
          "title": "Author",
          "type": "string"
        },
        "language": {
          "default": "ru",
          "pattern": "^[a-zA-Z]{2,8}(?:-[a-zA-Z0-9]{1,8})*$",
          "title": "Language",
          "type": "string"
        },
        "chapters": {
          "items": {
            "$ref": "#/$defs/Chapter"
          },
          "maxItems": 500,
          "title": "Chapters",
          "type": "array"
        }
      },
      "required": [
        "title"
      ],
      "title": "Manuscript",
      "type": "object"
    },
    "NameGenerator": {
      "additionalProperties": false,
      "properties": {
        "prefixes": {
          "items": {
            "type": "string"
          },
          "maxItems": 200,
          "minItems": 1,
          "title": "Prefixes",
          "type": "array"
        },
        "middles": {
          "items": {
            "type": "string"
          },
          "maxItems": 200,
          "minItems": 1,
          "title": "Middles",
          "type": "array"
        },
        "suffixes": {
          "items": {
            "type": "string"
          },
          "maxItems": 200,
          "minItems": 1,
          "title": "Suffixes",
          "type": "array"
        }
      },
      "title": "NameGenerator",
      "type": "object"
    },
    "NoteSave": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "note.save",
          "title": "Type",
          "type": "string"
        },
        "target": {
          "format": "uuid",
          "title": "Target",
          "type": "string"
        },
        "expected_revision": {
          "minimum": 0,
          "title": "Expected Revision",
          "type": "integer"
        },
        "payload": {
          "$ref": "#/$defs/ToolEntry"
        }
      },
      "required": [
        "type",
        "target",
        "expected_revision",
        "payload"
      ],
      "title": "NoteSave",
      "type": "object"
    },
    "OwnDelete": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "own.delete",
          "title": "Type",
          "type": "string"
        },
        "target": {
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "title": "Target",
          "type": "string"
        },
        "expected_revision": {
          "minimum": 1,
          "title": "Expected Revision",
          "type": "integer"
        }
      },
      "required": [
        "type",
        "target",
        "expected_revision"
      ],
      "title": "OwnDelete",
      "type": "object"
    },
    "OwnSet": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "own.set",
          "title": "Type",
          "type": "string"
        },
        "target": {
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "title": "Target",
          "type": "string"
        },
        "expected_revision": {
          "minimum": 0,
          "title": "Expected Revision",
          "type": "integer"
        },
        "value": {
          "$ref": "#/$defs/JsonValue"
        }
      },
      "required": [
        "type",
        "target",
        "expected_revision",
        "value"
      ],
      "title": "OwnSet",
      "type": "object"
    },
