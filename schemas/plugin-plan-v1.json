      "type": "object"
    },
    "TemplateRun": {
      "additionalProperties": false,
      "properties": {
        "expected_revision": {
          "minimum": 1,
          "title": "Expected Revision",
          "type": "integer"
        },
        "inputs": {
          "additionalProperties": {
            "type": "string"
          },
          "maxProperties": 32,
          "title": "Inputs",
          "type": "object"
        },
        "manuscript_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Manuscript Id"
        },
        "manuscript_revision": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Manuscript Revision"
        },
        "chapter_title": {
          "default": "Новая глава",
          "maxLength": 300,
          "minLength": 1,
          "title": "Chapter Title",
          "type": "string"
        },
        "type": {
          "const": "tool.template",
          "title": "Type",
          "type": "string"
        },
        "target": {
          "format": "uuid",
          "title": "Target",
          "type": "string"
        },
        "result_id": {
          "format": "uuid",
          "title": "Result Id",
          "type": "string"
        }
